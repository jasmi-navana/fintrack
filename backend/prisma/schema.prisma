generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  transactions Transaction[]
  goals Goal[]
}
model Transaction {
  id          Int      @id @default(autoincrement())
  title       String
  amount      Float
  type        String
  category    String
  createdAt   DateTime @default(now())

  userId      Int
  user        User @relation(fields: [userId], references: [id])
}
model Goal {
  id           Int      @id @default(autoincrement())
  title        String
  targetAmount Float
  months       Int

  userId       Int
  user         User @relation(fields: [userId], references: [id])

  createdAt    DateTime @default(now())
}